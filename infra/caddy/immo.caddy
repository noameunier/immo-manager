# ---------------------------------------------------------------------------
# Immo Manager — vhosts Caddy
# ---------------------------------------------------------------------------
# Ce fichier est la source de vérité versionnée. Il est copié dans
# /etc/caddy/immo.caddy par infra/bootstrap/install-caddy-import.sh (action
# humaine, avec sudo) : /home/dev est en 700, l'utilisateur « caddy » ne peut
# donc pas traverser le dépôt — un lien symbolique ferait échouer le service.
# Après une modification du dépôt, relancer le script (idempotent :
# il recopie le fichier puis recharge Caddy) :
#
#   sudo bash infra/bootstrap/install-caddy-import.sh
#
# Caddy valide la configuration avant tout rechargement ; un rechargement
# invalide laisse l'ancienne configuration active.
#
# Ne jamais exposer les ports applicatifs sur 0.0.0.0 : les reverse_proxy
# ci-dessous pointent exclusivement vers 127.0.0.1.
# ---------------------------------------------------------------------------

# --- Préproduction web : page + API same-origin ------------------------------
# Tout passe par Next.js, y compris /api/* : le route handler du web relaie vers
# l'API interne en retirant le préfixe /api. Router /api/* directement vers
# l'API renverrait « Cannot POST /api/... » (l'API n'expose pas ce préfixe).
staging-immo.noameunier.fr {
	encode zstd gzip

	handle {
		reverse_proxy 127.0.0.1:3200
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# --- Préproduction API mobile (jeton Bearer) -------------------------------
api-staging-immo.noameunier.fr {
	encode zstd gzip

	handle {
		reverse_proxy 127.0.0.1:4200
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}
}

# --- Développement web (VPS) ------------------------------------------------
# Ces deux vhosts peuvent être commentés si l'environnement de développement
# n'a pas à être joignable depuis Internet.
# Même principe qu'en préproduction : tout (y compris /api/*) va à Next.js.
immo.noameunier.fr {
	encode zstd gzip

	handle {
		reverse_proxy 127.0.0.1:3100
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# --- Développement API mobile ----------------------------------------------
api-immo.noameunier.fr {
	encode zstd gzip

	handle {
		reverse_proxy 127.0.0.1:4100
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}
}
