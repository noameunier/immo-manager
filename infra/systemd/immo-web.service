[Unit]
Description=Immo Manager — web (développement)
Documentation=file:///home/dev/repos/immo-manager/docs/ARCHITECTURE.md
After=network-online.target immo-api.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/dev/repos/immo-manager/apps/web
Environment=NODE_ENV=production
Environment=API_INTERNAL_URL=http://127.0.0.1:4100
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/home/dev/.local/opt/node/bin/node /home/dev/repos/immo-manager/apps/web/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3100
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
