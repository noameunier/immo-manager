# ---------------------------------------------------------------------------
# Immo Manager — configuration de sauvegarde
#
# Copier vers : /home/dev/.secrets/immo-manager/backup.env
# Puis        : chmod 600 /home/dev/.secrets/immo-manager/backup.env
#
# NE JAMAIS committer ce fichier ni la clé privée age.
# ---------------------------------------------------------------------------

# Clé publique age (générer avec : age-keygen -o ~/.secrets/immo-manager/age-key.txt)
AGE_RECIPIENT="age1remplacer-par-votre-cle-publique"

# Destination rclone (optionnel). Laisser vide pour une sauvegarde locale seule.
# Exemple : RCLONE_REMOTE="immo-backup:immo"
RCLONE_REMOTE=""

# Rétention
LOCAL_RETENTION_DAYS="7"
REMOTE_RETENTION_DAYS="30"

# Connexion (préproduction par défaut)
DB_CONTAINER="immo-staging-db"
DB_NAME="immo_staging"
DB_USER="immo"
DB_PORT="5435"
PGPASSWORD="remplacer-par-le-mot-de-passe-de-la-base"
