// ---------------------------------------------------------------------------
// Immo Manager — schéma de données (phase 1)
// ---------------------------------------------------------------------------
// Principes :
//  - Toute ressource métier est rattachée à un utilisateur (ownerId).
//  - Les associations inter-ressources utilisent des clés étrangères
//    COMPOSITES (id, ownerId) : le propriétaire est ainsi vérifié par
//    PostgreSQL lui-même, pas seulement par le code applicatif.
//  - La suppression métier est un archivage (archivedAt), jamais un DELETE.
// ---------------------------------------------------------------------------

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum OwnerEntityType {
  INDIVIDUAL // Personne physique
  SCI // Société civile immobilière
  COMPANY // Société (SARL, SAS, etc.)
  UNDIVIDED // Indivision
}

enum PropertyType {
  APARTMENT
  HOUSE
  GARAGE
  PARKING
  BOX
}

enum OccupancyStatus {
  VACANT
  OCCUPIED
  UNKNOWN
}

enum TenantType {
  INDIVIDUAL // Personne physique
  COMPANY // Société, association, organisme
}

enum LeaseType {
  NUE // Location nue (résidence principale)
  MEUBLEE // Location meublée
}

enum MediaKind {
  PHOTO
  DOCUMENT
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

// ---------------------------------------------------------------------------
// Comptes et sécurité
// ---------------------------------------------------------------------------

model User {
  id               String    @id @default(uuid(7)) @db.Uuid
  email            String    @unique @db.VarChar(254)
  passwordHash     String    @map("password_hash") @db.VarChar(255)
  fullName         String    @map("full_name") @db.VarChar(120)
  emailVerifiedAt  DateTime? @map("email_verified_at")
  locale           String    @default("fr-FR") @db.VarChar(10)
  timezone         String    @default("Europe/Paris") @db.VarChar(64)
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")
  lastLoginAt      DateTime? @map("last_login_at")
  totpSecret       String?   @map("totp_secret") @db.VarChar(255)
  totpEnabledAt    DateTime? @map("totp_enabled_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  archivedAt       DateTime? @map("archived_at")

  sessions    Session[]
  emailTokens EmailToken[]
  entities    OwnerEntity[]
  buildings   Building[]
  properties  Property[]
  tenants     Tenant[]
  leases      Lease[]
  mediaAssets MediaAsset[]
  auditLogs   AuditLog[]

  @@index([archivedAt])
  @@map("users")
}

/// Session opaque : seul le SHA-256 du jeton est stocké en base.
/// Le jeton en clair n'existe que chez le client (cookie httpOnly ou stockage sécurisé mobile).
model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  userAgent  String?   @map("user_agent") @db.VarChar(255)
  ipHash     String?   @map("ip_hash") @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// Jetons à usage unique pour vérification d'email et réinitialisation.
/// Stockés hachés (SHA-256), avec expiration et usage unique.
model EmailToken {
  id        String         @id @default(uuid(7)) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  type      EmailTokenType
  tokenHash String         @unique @map("token_hash") @db.VarChar(64)
  createdAt DateTime       @default(now()) @map("created_at")
  expiresAt DateTime       @map("expires_at")
  usedAt    DateTime?      @map("used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, usedAt])
  @@map("email_tokens")
}

/// Journal d'audit minimal : qui a fait quoi, sans données sensibles.
model AuditLog {
  id           String   @id @default(uuid(7)) @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String   @db.VarChar(64)
  resourceType String   @map("resource_type") @db.VarChar(64)
  resourceId   String?  @map("resource_id") @db.Uuid
  metadata     Json?
  ipHash       String?  @map("ip_hash") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Entités propriétaires
// ---------------------------------------------------------------------------

model OwnerEntity {
  id        String          @id @default(uuid(7)) @db.Uuid
  ownerId   String          @map("owner_id") @db.Uuid
  type      OwnerEntityType
  name      String          @db.VarChar(160)
  legalName String?         @map("legal_name") @db.VarChar(200)
  siren     String?         @db.VarChar(9)
  siret     String?         @db.VarChar(14)
  vatNumber String?         @map("vat_number") @db.VarChar(20)
  email     String?         @db.VarChar(254)
  phone     String?         @db.VarChar(32)

  addressLine1 String? @map("address_line1") @db.VarChar(200)
  addressLine2 String? @map("address_line2") @db.VarChar(200)
  postalCode   String? @map("postal_code") @db.VarChar(16)
  city         String? @db.VarChar(120)
  country      String  @default("FR") @db.VarChar(2)

  notes      String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")

  owner      User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  buildings  Building[]
  properties Property[]
  leases     Lease[]

  // Clé d'isolation : permet les FK composites (id, ownerId)
  @@unique([id, ownerId])
  @@index([ownerId, archivedAt])
  @@map("owner_entities")
}

// ---------------------------------------------------------------------------
// Patrimoine immobilier
// ---------------------------------------------------------------------------

model Building {
  id        String  @id @default(uuid(7)) @db.Uuid
  ownerId   String  @map("owner_id") @db.Uuid
  entityId  String  @map("entity_id") @db.Uuid
  name      String  @db.VarChar(160)
  reference String? @db.VarChar(64)

  addressLine1 String  @map("address_line1") @db.VarChar(200)
  addressLine2 String? @map("address_line2") @db.VarChar(200)
  postalCode   String  @map("postal_code") @db.VarChar(16)
  city         String  @db.VarChar(120)
  country      String  @default("FR") @db.VarChar(2)

  constructionYear Int?      @map("construction_year")
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  archivedAt       DateTime? @map("archived_at")

  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // FK composite : impossible de rattacher un immeuble à l'entité d'un autre propriétaire
  entity      OwnerEntity  @relation(fields: [entityId, ownerId], references: [id, ownerId], onDelete: Restrict)
  properties  Property[]
  mediaAssets MediaAsset[]

  @@unique([id, ownerId])
  @@index([ownerId, archivedAt])
  @@index([entityId, archivedAt])
  @@map("buildings")
}

model Property {
  id         String  @id @default(uuid(7)) @db.Uuid
  ownerId    String  @map("owner_id") @db.Uuid
  entityId   String  @map("entity_id") @db.Uuid
  buildingId String? @map("building_id") @db.Uuid

  name            String          @db.VarChar(160)
  reference       String?         @db.VarChar(64)
  type            PropertyType
  lotNumber       String?         @map("lot_number") @db.VarChar(32)
  floor           String?         @db.VarChar(16)
  surfaceM2       Decimal?        @map("surface_m2") @db.Decimal(8, 2)
  rooms           Int?
  occupancyStatus OccupancyStatus @default(UNKNOWN) @map("occupancy_status")
  description     String?

  addressLine1 String? @map("address_line1") @db.VarChar(200)
  addressLine2 String? @map("address_line2") @db.VarChar(200)
  postalCode   String? @map("postal_code") @db.VarChar(16)
  city         String? @db.VarChar(120)
  country      String  @default("FR") @db.VarChar(2)

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")

  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  entity      OwnerEntity  @relation(fields: [entityId, ownerId], references: [id, ownerId], onDelete: Restrict)
  building    Building?    @relation(fields: [buildingId, ownerId], references: [id, ownerId], onDelete: Restrict)
  leases      Lease[]
  mediaAssets MediaAsset[]

  @@unique([id, ownerId])
  @@unique([buildingId, lotNumber])
  @@index([ownerId, archivedAt])
  @@index([entityId, archivedAt])
  @@index([buildingId, archivedAt])
  @@map("properties")
}

// ---------------------------------------------------------------------------
// Exploitation locative
// ---------------------------------------------------------------------------

model Tenant {
  id      String     @id @default(uuid(7)) @db.Uuid
  ownerId String     @map("owner_id") @db.Uuid
  type    TenantType @default(INDIVIDUAL)
  name    String     @db.VarChar(160)
  email   String?    @db.VarChar(254)
  phone   String?    @db.VarChar(32)

  addressLine1 String? @map("address_line1") @db.VarChar(200)
  addressLine2 String? @map("address_line2") @db.VarChar(200)
  postalCode   String? @map("postal_code") @db.VarChar(16)
  city         String? @db.VarChar(120)
  country      String  @default("FR") @db.VarChar(2)

  notes      String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")

  owner  User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  leases Lease[]

  // Clé d'isolation : autorise les FK composites (id, ownerId)
  @@unique([id, ownerId])
  @@index([ownerId, archivedAt])
  @@map("tenants")
}

/// Bail : relie une entité (bailleur), un bien et un locataire.
/// Les dates sont des dates calendaires (pas d'heure) ; le statut est calculé
/// à la lecture à partir des dates et de l'archivage, jamais stocké.
model Lease {
  id         String @id @default(uuid(7)) @db.Uuid
  ownerId    String @map("owner_id") @db.Uuid
  entityId   String @map("entity_id") @db.Uuid
  propertyId String @map("property_id") @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid

  type          LeaseType @default(NUE)
  startsOn      DateTime  @map("starts_on") @db.Date
  endsOn        DateTime? @map("ends_on") @db.Date
  rentAmount    Decimal   @map("rent_amount") @db.Decimal(10, 2)
  chargesAmount Decimal   @default(0) @map("charges_amount") @db.Decimal(10, 2)
  depositAmount Decimal?  @map("deposit_amount") @db.Decimal(10, 2)
  paymentDay    Int       @default(1) @map("payment_day")
  notes         String?

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")

  owner    User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // FK composites : impossible de mélanger les patrimoines de deux propriétaires
  entity   OwnerEntity @relation(fields: [entityId, ownerId], references: [id, ownerId], onDelete: Restrict)
  property Property    @relation(fields: [propertyId, ownerId], references: [id, ownerId], onDelete: Restrict)
  tenant   Tenant      @relation(fields: [tenantId, ownerId], references: [id, ownerId], onDelete: Restrict)

  @@unique([id, ownerId])
  @@index([ownerId, archivedAt])
  @@index([propertyId, archivedAt])
  @@index([tenantId, archivedAt])
  @@index([entityId, archivedAt])
  @@map("leases")
}

/// Métadonnées des photos et documents.
/// Le stockage binaire (disque local en dev, S3-compatible en production)
/// est abstrait derrière StorageService ; seul le descriptif est en base.
model MediaAsset {
  id         String    @id @default(uuid(7)) @db.Uuid
  ownerId    String    @map("owner_id") @db.Uuid
  propertyId String?   @map("property_id") @db.Uuid
  buildingId String?   @map("building_id") @db.Uuid
  kind       MediaKind @default(PHOTO)
  storageKey String    @unique @map("storage_key") @db.VarChar(255)
  fileName   String    @map("file_name") @db.VarChar(255)
  mimeType   String    @map("mime_type") @db.VarChar(100)
  sizeBytes  Int       @map("size_bytes")
  isPrimary  Boolean   @default(false) @map("is_primary")
  createdAt  DateTime  @default(now()) @map("created_at")
  archivedAt DateTime? @map("archived_at")

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId, ownerId], references: [id, ownerId], onDelete: Cascade)
  building Building? @relation(fields: [buildingId, ownerId], references: [id, ownerId], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@index([propertyId])
  @@index([buildingId])
  @@map("media_assets")
}
