{
  "expo": {
    "name": "Immo Manager",
    "slug": "immo-manager",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "immo-manager",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.noameunier.immomanager",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "fr.noameunier.immomanager",
      "softwareKeyboardLayoutMode": "pan",
      "blockedPermissions": ["android.permission.READ_EXTERNAL_STORAGE"]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://10.0.2.2:4100"
    }
  }
}
