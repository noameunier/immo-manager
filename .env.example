# ---------------------------------------------------------------------------
# Immo Manager — variables d'environnement (développement)
# Copier ce fichier vers .env puis renseigner les valeurs.
# NE JAMAIS committer un fichier .env ni un secret.
# ---------------------------------------------------------------------------

# --- Base de données (conteneur Docker de développement) --------------------
DATABASE_URL="postgresql://immo:immo_dev_only@127.0.0.1:5434/immo_dev?schema=public"
# Base utilisée par les tests d'intégration (créée par scripts/db-test-setup.sh)
TEST_DATABASE_URL="postgresql://immo:immo_dev_only@127.0.0.1:5434/immo_test?schema=public"

# --- API --------------------------------------------------------------------
NODE_ENV="development"
# 3100 = web Next.js, 4100 = API NestJS
API_PORT="4100"
API_HOST="127.0.0.1"
# Origines autorisées à appeler l'API depuis un navigateur (CORS + contrôle CSRF)
WEB_ORIGIN="http://localhost:3100"
MOBILE_ORIGIN="http://localhost:8100"

# Secret de signature des jetons à usage unique (email, reset)
# Générer avec : openssl rand -base64 48
APP_SECRET="remplacer-par-un-secret-local-de-48-octets"

# --- Emails -----------------------------------------------------------------
# En développement : Mailpit local (aucun email ne sort du VPS)
# Console visible : http://127.0.0.1:8026
MAIL_TRANSPORT="mailpit"
MAIL_FROM="Immo Manager <no-reply@noameunier.fr>"
SMTP_HOST="127.0.0.1"
SMTP_PORT="1026"
SMTP_USER=""
SMTP_PASSWORD=""
# Fournisseur réel (préproduction/production) : brevo | scaleway | ovh | resend
MAIL_PROVIDER="mailpit"
MAIL_API_KEY=""

# Exiger un email vérifié pour se connecter (false en dev, true en staging/prod)
REQUIRE_EMAIL_VERIFICATION="false"

# --- Sécurité ---------------------------------------------------------------
# Durée de vie des sessions (jours)
SESSION_TTL_DAYS="30"
# Durée de vie des jetons email (minutes)
EMAIL_TOKEN_TTL_MINUTES="60"
# Nom du cookie de session web
SESSION_COOKIE_NAME="immo_session"
# Derrière un proxy de confiance (Caddy) en staging/production
TRUST_PROXY="false"

# --- Web (Next.js) ----------------------------------------------------------
NEXT_PUBLIC_API_URL="/api"
